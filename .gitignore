# OS artefacts
.DS_Store
Thumbs.db
desktop.ini
*Zone.Identifier

# IDE
.idea/
.vscode/
*.iml
*.iws

# Node
node_modules/
npm-debug.log*
yarn-error.log*
yarn.lock

# PHP / Composer
vendor/
composer.lock

# AMD build artefacts: these ARE committed. Moodle serves them at runtime and
# the CI validates them from the repo (thirdpartylibs.xml references the bundled
# editor). The amd/src sources build init.min.js via Grunt; editor_lazy.min.js is
# the prebuilt React bundle (esbuild). Both must be present in the repository.
# (Intentionally NOT ignoring amd/build/.)

# moodle-plugin-ci working directories
ci/
moodle/

# PHPUnit / coverage
.phpunit.result.cache
.phpunit.cache/
coverage/
*.clover

# Behat screenshots
behatfaildumps/

# Temporary / backup files
*.bak
*.tmp
*.swp
*~

# Local developer overrides
.env
.env.local

# Load-test downloads and run artefacts. The harness itself (seed, .jmx, .k6.js,
# README) is versioned; the tools it fetches and the results it produces are not.
tests/load/apache-jmeter-*/
tests/load/k6
tests/load/*.tgz
tests/load/*.jtl
tests/load/jmeter.log
tests/load/itemids.csv
tests/load/.load-env
tests/load/.load-seed.out

# Playwright run artefacts (the suite itself is versioned; its output is not).
tests/playwright/node_modules/
tests/playwright/test-results/
tests/playwright/playwright-report/
tests/playwright/.env
tests/playwright/.env.sh
tests/playwright/blob-report/
